# Local SonoDrop reverse-engineering reference artifacts
sonodrop-source/

# Smali disassembly kept as protocol evidence (see its README). This is another
# vendor's code: kept for interoperability analysis only, never compiled into
# the app and never redistributed. The APK it came from is already ignored
# above, so this must be too.
sonodrop-decompiled/smali/

# Built APKs, kept outside the Gradle tree so a clean does not delete them.
# The debug build is ~215 MB and carries all dev tooling; drop it first if disk
# space is tight, the release one is the deliverable.
apk-output/
t.txt
testout.txt
